{
  "mcpServers": {
    "dbt-governed-read-only": {
      "command": "<VENV_EXECUTABLES>/dbt-mcp[.exe]",
      "args": [],
      "env": {
        "DBT_PROJECT_DIR": "<ABSOLUTE_PATH>/lab/dabdbt",
        "DBT_PATH": "<VENV_EXECUTABLES>/dbt[.exe]",
        "DBT_PROFILES_DIR": "<ABSOLUTE_PATH>/lab/dabdbt/dbt_profiles",
        "DBT_MCP_ENABLE_TOOLS": "compile,list,parse,get_lineage_dev,get_node_details_dev",
        "DBT_MCP_LOG_LEVEL": "INFO"
      }
    }
  }
}
