{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/rescuepoint/agent-benchmark-report.schema.json",
  "title": "Relatório normalizado do benchmark de agentes",
  "type": "object",
  "required": ["generated_from_fixtures", "records", "summaries"],
  "properties": {
    "generated_from_fixtures": {"type": "boolean"},
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["mode", "question_id", "question", "expected_answer", "sql", "result", "tokens_input", "tokens_output", "tool_calls", "latency_ms", "normalized_cost", "invalid_join", "correct"],
        "properties": {
          "mode": {"enum": ["raw_schema", "manifest_context", "semantic_mcp"]},
          "question_id": {"type": "string"},
          "question": {"type": "string"},
          "expected_answer": {},
          "sql": {"type": "string"},
          "result": {},
          "tokens_input": {"type": "integer", "minimum": 0},
          "tokens_output": {"type": "integer", "minimum": 0},
          "tool_calls": {"type": "integer", "minimum": 0},
          "latency_ms": {"type": "integer", "minimum": 0},
          "normalized_cost": {"type": "number", "minimum": 0},
          "invalid_join": {"type": "boolean"},
          "correct": {"type": "boolean"}
        }
      }
    },
    "summaries": {"type": "array", "minItems": 1}
  }
}
