{
  "name": "dbt Moderno na Prática",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "hostRequirements": {
    "cpus": 2,
    "memory": "4gb",
    "storage": "2gb"
  },
  "postCreateCommand": "python course.py setup",
  "postStartCommand": "python course.py doctor",
  "forwardPorts": [4213],
  "portsAttributes": {
    "4213": {
      "label": "DuckDB UI",
      "onAutoForward": "notify",
      "protocol": "http"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "redhat.vscode-yaml"
      ]
    }
  },
  "remoteUser": "vscode"
}
