{
  "name": "dbt Moderno na Prática",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "hostRequirements": {
    "cpus": 2,
    "memory": "4gb",
    "storage": "2gb"
  },
  "postCreateCommand": "python course.py setup",
  "postStartCommand": "python course.py doctor && python course.py paths",
  "remoteEnv": {
    "PATH": "${containerWorkspaceFolder}/lab/dabdbt/.venv/bin:${containerEnv:PATH}",
    "DBT_PROFILES_DIR": "${containerWorkspaceFolder}/lab/dabdbt/dbt_profiles"
  },
  "forwardPorts": [4213],
  "portsAttributes": {
    "4213": {
      "label": "Explorador DuckDB",
      "onAutoForward": "notify",
      "protocol": "http"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "redhat.vscode-yaml"
      ]
    }
  },
  "remoteUser": "vscode"
}
